#!/bin/sh

set -e

case "${1}" in
  configure)
    if [ -z "$2" ]; then
      rcn nonint set_wayland 1 || true
      rcn nonint set_boot_desktop 0 || true
      rcn nonint set_autologin_cli 0 || true
      rcn nonint set_autologin_desktop 0 || true
      update-desktop-database /usr/share/raspi-ui-overrides/applications/
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;

  *)
    echo "postinst called with unknown argument \`${1}'" >&2
    exit 1
    ;;
esac

#DEBHELPER#
